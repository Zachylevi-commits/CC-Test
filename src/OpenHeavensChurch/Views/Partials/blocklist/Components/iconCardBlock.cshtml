@model Umbraco.Cms.Core.Models.Blocks.BlockListItem
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@{
    var c = Model.Content;
    var icon = c.Value<string>("icon");
    var title = c.Value<string>("title");
    var body = c.Value<string>("body");
    var link = c.Value<Umbraco.Cms.Core.Models.Link>("link");
}
<article class="icon-card">
    @if (!string.IsNullOrWhiteSpace(icon))
    {
        <span class="icon-card__icon" aria-hidden="true">@icon</span>
    }
    <h3 class="icon-card__title">@title</h3>
    @if (!string.IsNullOrWhiteSpace(body))
    {
        <p>@body</p>
    }
    @if (link is not null)
    {
        <a class="icon-card__link" href="@link.Url" target="@link.Target">@link.Name</a>
    }
</article>
