@model Umbraco.Cms.Core.Models.Blocks.BlockGridItem
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@{
    var c = Model.Content;
    var title = c.Value<string>("title");
    var start = c.Value<DateTime?>("startsAt");
    var end = c.Value<DateTime?>("endsAt");
    var image = c.Value<IPublishedContent>("image");
    var description = c.Value<string>("description");
    var location = c.Value<string>("location");
    var registerLink = c.Value<Umbraco.Cms.Core.Models.Link>("registerLink");
}
<article class="block block--event event-card">
    @if (image is not null)
    {
        <div class="event-card__image" style="background-image:url('@image.Url()')" aria-hidden="true"></div>
    }
    <div class="event-card__body">
        <h3 class="event-card__title">@title</h3>
        @if (start.HasValue)
        {
            <time class="event-card__time" datetime="@start.Value.ToString("o")">
                @start.Value.ToString("dddd, MMM d • h:mm tt")
                @if (end.HasValue) { <text>– @end.Value.ToString("h:mm tt")</text> }
            </time>
        }
        @if (!string.IsNullOrWhiteSpace(location))
        {
            <p class="event-card__location">@location</p>
        }
        @if (!string.IsNullOrWhiteSpace(description))
        {
            <p class="event-card__description">@description</p>
        }
        @if (registerLink is not null)
        {
            <a class="btn btn--primary" href="@registerLink.Url" target="@registerLink.Target">@registerLink.Name</a>
        }
    </div>
</article>
