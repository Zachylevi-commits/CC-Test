{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "00000000-0000-0000-0000-000000000000",
        "SanitizeTinyMce": true,
        "TimeOut": "00:20:00",
        "UseHttps": false
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Hosting": {
        "Debug": false
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeAuto",
        "ModelsNamespace": "OpenHeavensChurch.Models.Generated",
        "FlagOutOfDateModels": true
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true,
        "ApiKey": "REPLACE_WITH_GENERATED_KEY"
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=(local);Database=OpenHeavensChurch;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "OpenHeavensChurch": {
    "YouTube": {
      "ApiKey": "REPLACE_WITH_YOUTUBE_API_KEY",
      "ChannelId": "REPLACE_WITH_CHANNEL_ID",
      "MaxResults": 12,
      "CacheMinutes": 30
    },
    "Songs": {
      "FeedUrl": "https://example.com/openheavens/songs.json",
      "CacheMinutes": 60
    },
    "Articles": {
      "Source": "Umbraco",
      "ExternalFeedUrl": "https://example.com/openheavens/articles.json",
      "CacheMinutes": 30
    },
    "Contact": {
      "NotifyEmail": "office@openheavenschurch.example",
      "FromEmail": "no-reply@openheavenschurch.example"
    }
  },
  "AllowedHosts": "*"
}
